generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String           @id @default(cuid())
  email             String           @unique
  name              String
  unidadeOrganica   UnidadeOrganica? @relation(fields: [unidadeOrganicaId], references: [id])
  unidadeOrganicaId String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model UnidadeOrganica {
  id        String   @id @default(cuid())
  nome      String
  codigo    String   @unique
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Processo {
  id                   String           @id @default(cuid())
  numeroInterno        String           @unique
  numeroProcuradoria   String?          @unique
  estado               String
  origem               String
  tipicidadeCodigo     String?
  tipicidadeDesignacao String?
  tipicidadeArtigoCpp  String?
  piqueteId            String?
  instrutorId          String?
  unidadeActualId      String
  dataInstauracao      DateTime
  dataUltimaTransicao  DateTime
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  actos                ActoPiquete[]
  pecas                PecaProcessual[]
}

model ActoPiquete {
  id             String    @id @default(cuid())
  tipoActoId     String
  tipoActoCodigo String
  piqueteId      String
  userRegistoId  String
  numeroActo     String    @unique
  factos         String
  dados          Json
  estado         String
  processoId     String?
  geraProcesso   Boolean
  dataRegisto    DateTime
  processo       Processo? @relation(fields: [processoId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model PecaProcessual {
  id            String    @id @default(cuid())
  processoId    String
  templateId    String
  tipo          String
  numeroOrdem   Int
  dados         Json
  estado        String
  hashDocumento String?
  pdfPath       String?
  criadaPor     String
  criadaEm      DateTime
  assinadaPor   String?
  assinadaEm    DateTime?
  processo      Processo  @relation(fields: [processoId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([processoId, numeroOrdem])
}
