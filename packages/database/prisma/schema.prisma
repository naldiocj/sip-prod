generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String           @id @default(cuid())
  email             String           @unique
  name              String
  unidadeOrganica   UnidadeOrganica? @relation(fields: [unidadeOrganicaId], references: [id])
  unidadeOrganicaId String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model UnidadeOrganica {
  id        String   @id @default(cuid())
  nome      String
  codigo    String   @unique
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
