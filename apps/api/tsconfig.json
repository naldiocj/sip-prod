{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "dist",
    "rootDir": "src",
    "noEmit": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "types": [
      "node"
    ],
    "baseUrl": "..",
    "paths": {
      "@sip/database": [
        "packages/database/src"
      ],
      "@sip/config": [
        "packages/config/src"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}